<?xml version="1.0" encoding="UTF-8"?>
<!-- Schema for the directory of National Parks (CSE445 Assignment 4, Q1.1) -->
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
   xmlns="http://www.cse445.asu.edu/NationalParks"
   targetNamespace="http://www.cse445.asu.edu/NationalParks"
   elementFormDefault="qualified" attributeFormDefault="unqualified">

  <!-- Root element: a directory holding one or more national parks -->
  <xsd:element name="NationalParks" type="NationalParksType"/>

  <xsd:complexType name="NationalParksType">
    <xsd:sequence>
      <xsd:element name="NationalPark" type="NationalParkType" minOccurs="1" maxOccurs="unbounded"/>
    </xsd:sequence>
  </xsd:complexType>

  <!-- One national park: Name, one or more Phone, Address (left-to-right order); optional Rating attribute -->
  <xsd:complexType name="NationalParkType">
    <xsd:sequence>
      <xsd:element name="Name" type="xsd:string"/>
      <xsd:element name="Phone" type="xsd:string" minOccurs="1" maxOccurs="unbounded"/>
      <xsd:element name="Address" type="AddressType"/>
    </xsd:sequence>
    <xsd:attribute name="Rating" type="xsd:string" use="optional"/>
  </xsd:complexType>

  <!-- Address: Number, Street, City, State, Zip; required NearestAirport attribute -->
  <xsd:complexType name="AddressType">
    <xsd:sequence>
      <xsd:element name="Number" type="xsd:int"/>
      <xsd:element name="Street" type="xsd:string"/>
      <xsd:element name="City" type="xsd:string"/>
      <xsd:element name="State" type="xsd:string"/>
      <!-- string, not int, so ZIP codes with a leading zero (e.g. 04609) keep it -->
      <xsd:element name="Zip" type="xsd:string"/>
    </xsd:sequence>
    <xsd:attribute name="NearestAirport" type="xsd:string" use="required"/>
  </xsd:complexType>

</xsd:schema>
